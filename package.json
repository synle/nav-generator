{
  "name": "synle-nav-generator",
  "version": "1.3.0",
  "private": true,
  "description": "Application to organize and generate bookmarks",
  "keywords": [
    "Le",
    "Sy"
  ],
  "license": "ISC",
  "author": "Sy Le",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "clean": "rm -rf import-map.json .oxfmt-cache",
    "build": "NODE_ENV=production vite build",
    "format": "oxfmt --write .",
    "start": "npx http-server --cors -a 127.0.0.1 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "c8": "^11.0.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^29.0.2",
    "oxfmt": "^0.61.0",
    "sass": "^1.99.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
